# --- Server ---
PORT=3019
HOST=0.0.0.0
LOG_LEVEL=info
# Set true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
TLS_CERT_PATH=
TLS_KEY_PATH=
BODY_LIMIT=262144

# --- Storage ---
DB_PATH=./data/payments.db
DB_BACKUP_DIR=

# --- Callers: id:secret:role, comma separated. Secrets >= 32 chars, unique. Generate: openssl rand -hex 32
# Roles: read (payments, ledger, provider events, stats, metrics), write (also create, cancel, sync, refund).
PAYMENTS_API_KEYS=atc-console:REPLACE_WITH_64_HEX_CHARS:write,shop:REPLACE_WITH_64_HEX_CHARS:write
RATE_LIMIT_MAX=600

# --- Stripe. Empty secret key = provider disabled (creates answer 503, /ready says "provider":"disabled").
# Use a restricted key (rk_…) with write access to PaymentIntents and Refunds where you can.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (Dashboard → Developers → Webhooks). Empty = webhook endpoint answers 503.
STRIPE_WEBHOOK_SECRET=
STRIPE_API_URL=https://api.stripe.com
STRIPE_TIMEOUT_MS=20000
# Accepted age of a webhook signature, seconds.
WEBHOOK_TOLERANCE_SEC=300

# --- Limits ---
CURRENCIES=usd,eur,gbp,try
# Minor units (cents).
MIN_AMOUNT=50
MAX_AMOUNT=99999999
IDEMPOTENCY_TTL_HOURS=24
EVENT_RETENTION_DAYS=30

# --- Events to atc-webhook-out (optional): payment.* and refund.* with an idempotency key each. Both or neither.
# A publish-role key: WEBHOOK_API_KEYS=atc-payments:…:publish
WEBHOOK_OUT_URL=
WEBHOOK_OUT_API_KEY=
WEBHOOK_OUT_TIMEOUT_MS=10000
OUTBOX_MS=2000
OUTBOX_MAX_ATTEMPTS=20

# --- Audit (optional): forward payment events to the audit service. Both or neither. A write-role key: AUDIT_API_KEYS=atc-payments:…:write
AUDIT_URL=
AUDIT_API_KEY=
